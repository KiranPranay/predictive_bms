# Target and flash
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 1 kHz tick so the 200 ms sample period and the ADS1115 waits are exact
CONFIG_FREERTOS_HZ=1000

# Section 10: a stalled safety task restarts the ESP32, which opens both relays
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=2
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_BROWNOUT_DET=y

# Stacks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The dashboard request headers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
